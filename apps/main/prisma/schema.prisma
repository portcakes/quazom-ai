// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model User {
  id              String            @id
  name            String
  email           String
  emailVerified   Boolean           @default(false)
  image           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  sessions        Session[]
  accounts        Account[]
  curricula       Curriculum[]
  userEvaluations UserEvaluations[]
  notes           Note[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Curriculum {
  id                   String   @id
  userId               String
  title                String
  subject              String
  level                String
  goal                 String
  overview             String
  estimatedDuration    String
  objectives           Json
  modules              Json
  recommendedResources Json
  raw_ai_response      String
  structured_data_json Json
  isHidden             Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  curriculumModules    Module[]
  notes                Note[]

  @@index([userId])
  @@map("curriculum")
}

model Module {
  id           String     @id
  curriculumId String
  curriculum   Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  title        String
  summary      String
  // 1-indexed position within the curriculum, used to render modules in order
  order        Int        @default(0)
  objectives   Json
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  lessons      Lesson[]

  @@index([curriculumId])
  @@map("module")
}

enum LessonActivityType {
  VIDEO
  QUIZ
  EXERCISE
  PROJECT
  DISCUSSION
  READING
  OTHER
}

// Tracks whether the lesson has had its full AI content + per-type child rows
// generated. STUB rows are created at curriculum-creation time so each lesson
// already has a stable id/url; READY means a full generation has succeeded.
enum LessonStatus {
  STUB
  GENERATING
  READY
  FAILED
}

model Lesson {
  id                   String             @id
  moduleId             String
  module               Module             @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title                String
  description          String             @default("")
  summary              String             @default("")
  activityType         LessonActivityType
  // 1-indexed position within the module
  order                Int                @default(0)
  status               LessonStatus       @default(STUB)
  content              String             @default("")
  duration             String             @default("")
  objectives           Json               @default("[]")
  recommendedResources Json               @default("[]")
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  quizzes              Quiz[]
  videos               Video[]
  exercises            Exercise[]
  projects             Project[]
  discussions          Discussion[]
  readings             Readings[]
  notes                Note[]

  @@index([moduleId])
  @@map("lesson")
}

model Video {
  id           String   @id
  lessonId     String
  lesson       Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title        String
  description  String
  // AI overview shown above the embed, distinct from the AI's short description
  overview     String   @default("")
  embedUrl     String
  // External link surfaced when embedUrl can't be embedded (non-YouTube, etc.)
  externalUrl  String?
  thumbnailUrl String?
  duration     String   @default("")
  isCompleted  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([lessonId])
  @@map("video")
}

model Quiz {
  id             String   @id
  lessonId       String
  lesson         Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title          String
  // Array of QuizQuestion: { question, answers: string[], correctAnswerIndex }
  questions      Json
  // Array of indices the user submitted, parallel to questions
  userAnswers    Json?
  feedback       Json?
  score          Int      @default(0)
  maxScore       Int      @default(100)
  passScore      Int      @default(65)
  isPassed       Boolean  @default(false)
  isCompleted    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([lessonId])
  @@map("quiz")
}

model Exercise {
  id           String   @id
  lessonId     String
  lesson       Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title        String
  description  String
  // Same shape as Quiz.questions — exercises are MC assessments per spec
  questions    Json
  hints        Json     @default("[]")
  userAnswers  Json?
  score        Int      @default(0)
  maxScore     Int      @default(100)
  passScore    Int      @default(65)
  isPassed     Boolean  @default(false)
  isCompleted  Boolean  @default(false)
  feedback     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([lessonId])
  @@map("exercise")
}

enum ProjectType {
  PRESENTATION
  REPORT
  ARTICLE
  ESSAY
  RESEARCH_PAPER
  THESIS
  CODE_SNIPPET
  CODE_PROJECT
  OTHER
}

model Project {
  id                   String      @id
  lessonId             String
  lesson               Lesson      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title                String
  summary              String
  // Rubric-style objectives the learner must meet
  objectives           Json
  recommendedResources Json
  projectType          ProjectType
  submissionUrl        String?
  isCompleted          Boolean     @default(false)
  feedback             Json?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  @@index([lessonId])
  @@map("project")
}

model Discussion {
  id                   String   @id
  lessonId             String
  lesson               Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title                String
  summary              String
  // Talking points / objectives the discussion should explore
  objectives           Json
  recommendedResources Json
  // Array of { role: 'assistant' | 'user', content: string, createdAt: ISO }
  chatHistory          Json     @default("[]")
  isCompleted          Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([lessonId])
  @@map("discussion")
}

model Readings {
  id                   String   @id
  lessonId             String
  lesson               Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title                String
  summary              String
  // Topic overview displayed above the deep-dive
  overview             String   @default("")
  // The main body / deep-dive content (markdown)
  content              String
  recommendedResources Json
  isCompleted          Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([lessonId])
  @@map("readings")
}

// Single polymorphic notes table. A note belongs to a user and can optionally
// be scoped to a lesson and/or a curriculum:
//  - lessonId set, curriculumId set     → in-lesson note (also surfaces in the
//                                         curriculum's Notes tab via curriculumId)
//  - lessonId null, curriculumId set    → curriculum-level note
//  - lessonId null, curriculumId null   → free-form user note (homepage / /notes)
model Note {
  id           String      @id
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId     String?
  lesson       Lesson?     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  curriculumId String?
  curriculum   Curriculum? @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  title        String?
  content      String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([userId])
  @@index([lessonId])
  @@index([curriculumId])
  @@map("note")
}

model UserEvaluations {
  id         String   @id
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  evaluation Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@map("user_evaluations")
}
