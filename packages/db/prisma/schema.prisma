// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String              @id
  name                 String
  email                String
  emailVerified        Boolean             @default(false)
  image                String?
  // Grants access to the apps/admin analytics console. Flipped manually in
  // the database — there is no UI that mints admins. Defaults to false so a
  // compromised signup flow can't escalate.
  isAdmin              Boolean             @default(false)
  // Alpha-program flag. Drives the per-user generation limits (curricula,
  // lessons, discussions) when the user has no paid subscription. Every
  // existing and new user defaults to true until the alpha period ends; a
  // paid Polar subscription supersedes alpha caps via `subscriptionPlan`.
  isAlpha              Boolean             @default(true)
  // Active paid plan slug, mirrored from the user's Polar customer state by
  // the polar webhook. NULL means no paid plan (alpha or free). Currently
  // one of: "EXPLORER", "SCHOLAR".
  subscriptionPlan     String?
  // Billing interval for the active subscription: "MONTH" or "YEAR". NULL
  // when `subscriptionPlan` is NULL.
  subscriptionInterval String?
  // Stable Polar customer id for this user — set when Polar's "customer
  // created" webhook fires (or when checkout opens). Lets the webhook
  // route customer-scoped events back to the right user without an
  // email lookup.
  polarCustomerId      String?
  // Slugs of the long-form titles ("Founding Explorer", etc.) the user
  // has unlocked. Earned by upgrading to a paid plan during the relevant
  // window; persisted forever once granted so a downgrade doesn't strip
  // the badge they paid to earn.
  earnedTitles         String[]            @default([])
  // Currently displayed title slug — must be a member of `earnedTitles`.
  // NULL hides any title from the sidebar.
  selectedTitle        String?
  // Soft-disable. When true, the user can sign in but `requireAuth` bounces
  // them to /account-disabled where they can re-enable or sign out. Hard
  // deletes go through Better Auth + Prisma cascade and do not set this.
  isDisabled           Boolean             @default(false)
  disabledAt           DateTime?
  // First-time onboarding gate. Defaults to false on signup; flips true
  // once the user finishes (or skips) the onboarding survey. `requireAuth`
  // bounces non-onboarded users to /onboarding.
  isOnboarded          Boolean             @default(false)
  // Optional answer to the "how did you hear about Quazom?" survey shown at
  // the end of onboarding. Single-column for now; if the survey grows we'll
  // promote this to its own table.
  referralSource       String?
  // IANA timezone identifier (e.g. "America/Los_Angeles"). Used to anchor
  // daily check-ins to the learner's local calendar day so a user in Tokyo
  // doesn't have to wait until lunchtime UTC for a fresh check-in to unlock.
  // Defaults to UTC; the settings page surfaces this so users can override.
  timezone             String              @default("UTC")
  // Persisted appearance preference. Defaults to LIGHT so a brand-new
  // account always boots into the canonical paper-coloured UI; users can
  // switch to DARK or SYSTEM (follow OS) from Settings, and the choice
  // syncs across every device they sign into. The next-themes client
  // wrapper still owns the live `.dark` class on <html>; this column is
  // the cross-device source of truth that gets pushed into next-themes
  // on app boot.
  themeMode            ThemeMode           @default(LIGHT)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  sessions             Session[]
  accounts             Account[]
  curricula            Curriculum[]
  userEvaluations      UserEvaluations[]
  notes                Note[]
  annotations          Annotation[]
  studySchedules       StudySchedule[]
  studySessions        StudySession[]
  checkIns             CheckIn[]
  aiUsage              AiUsage[]
  resources            Resource[]
  continuityNotes      ContinuityNote[]
  generatedAudios      GeneratedAudio[]
  audioPlaylist        AudioPlaylistItem[]

  @@unique([email])
  @@map("user")
}

// Cross-device appearance preference. SYSTEM defers to the OS-level
// "prefers-color-scheme" media query at render time. New users default
// to LIGHT.
enum ThemeMode {
  LIGHT
  DARK
  SYSTEM
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// Whether a curriculum was generated from a single subject/topic + optional
// goal (SINGLE) or assembled from two or more sources — extra topics, uploaded
// files, saved links, etc. (CONTINUITY). The split drives a separate quota
// bucket because Continuity Curricula run on a much larger prompt and cost
// significantly more tokens to generate.
enum CurriculumKind {
  SINGLE
  CONTINUITY
}

// Lifecycle for a Curriculum row. Continuity (and now single-source)
// curricula are pre-created in PENDING while the Inngest function runs so
// the detail page has something to render and source ownership is checked
// at creation time. READY is the terminal happy state; FAILED captures
// generation errors so the UI can offer a retry.
enum CurriculumStatus {
  PENDING
  READY
  FAILED
}

model Curriculum {
  id                    String               @id
  userId                String
  title                 String
  // For continuity curricula with no anchoring topic, `subject` and `goal`
  // can be empty strings — kept non-null so existing rows stay valid and
  // every downstream consumer can rely on the column being present.
  subject               String
  level                 String
  goal                  String
  overview              String
  estimatedDuration     String
  objectives            Json
  modules               Json
  recommendedResources  Json
  raw_ai_response       String
  structured_data_json  Json
  isHidden              Boolean              @default(false)
  // SINGLE = topic + optional 1 source; CONTINUITY = 2+ sources. See enum.
  kind                  CurriculumKind       @default(SINGLE)
  // Lifecycle flag, see enum. Newly inserted rows from the tRPC layer start
  // PENDING and flip to READY once the matching Inngest function finishes;
  // legacy rows were inserted directly by Inngest and so default to READY
  // via the migration's data-fix step.
  status                CurriculumStatus     @default(PENDING)
  // Optional short failure reason shown on the detail page when status is
  // FAILED. Kept off the index so the index stays cheap.
  statusMessage         String?
  // Optional user-supplied (or AI-generated from continuity notes) thesis
  // statement injected at the top of the curriculum prompt for continuity
  // curricula. NULL for single-source curricula.
  thesis                String?
  // Which lesson activity types the generator is permitted to emit when
  // building this curriculum (and when extending it to the next level).
  // Defaults to the full set so existing tooling continues to work without
  // a code change. Empty array is treated as "no preference" downstream so
  // we never accidentally generate a curriculum with zero lesson types.
  includedActivityTypes LessonActivityType[] @default([VIDEO, QUIZ, EXERCISE, PROJECT, DISCUSSION, READING, OTHER])
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  curriculumModules     Module[]
  notes                 Note[]
  studySchedule         StudySchedule?
  // User-attached resources (uploaded files or saved links) the user has
  // pinned to this curriculum. The AI's `recommendedResources` JSON column
  // above is a separate concept — those are model suggestions surfaced in
  // the Resources tab alongside this list of learner-owned resources.
  resourceLinks         ResourceCurriculum[]
  // Inputs the user fed into the generator (topics, links, files, continuity
  // notes). Preserved so the Sources panel on the curriculum page can list
  // exactly what shaped the AI's output.
  sources               CurriculumSource[]
  generatedAudios       GeneratedAudio[]

  @@index([userId])
  @@index([userId, kind])
  @@index([status])
  @@map("curriculum")
}

// What kind of input a CurriculumSource row represents. TOPIC is a free-text
// extra topic chip from the modal; LINK_RESOURCE / FILE_RESOURCE point at an
// owned Resource row; CONTINUITY_NOTE references a note that was used to
// seed the thesis (kept for provenance, not re-read at generation time).
enum CurriculumSourceKind {
  TOPIC
  LINK_RESOURCE
  FILE_RESOURCE
  CONTINUITY_NOTE
}

// One input ingredient that shaped a Curriculum. For continuity curricula
// there will be 2+; for single-source curricula 0 or 1. The row carries the
// original ordering so the UI can display sources in the order the user
// added them in the modal.
model CurriculumSource {
  id               String               @id
  curriculumId     String
  curriculum       Curriculum           @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  kind             CurriculumSourceKind
  // 0-indexed position within the curriculum's source list as the user
  // arranged them. Used for stable rendering only — generation does not
  // depend on order.
  order            Int                  @default(0)
  // TOPIC rows: the free-text topic the user typed.
  topicText        String?
  // LINK_RESOURCE / FILE_RESOURCE rows: the Resource this source came from.
  // SetNull on delete so a deleted resource leaves an orphan source row the
  // UI can still show ("Source no longer available") rather than vanishing
  // silently.
  resourceId       String?
  resource         Resource?            @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  // CONTINUITY_NOTE rows: the note id the thesis was generated from. Not a
  // FK so a deleted note still leaves a provenance trail.
  continuityNoteId String?
  createdAt        DateTime             @default(now())

  @@index([curriculumId])
  @@index([resourceId])
  @@map("curriculum_source")
}

model Module {
  id           String     @id
  curriculumId String
  curriculum   Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  title        String
  summary      String
  // 1-indexed position within the curriculum, used to render modules in order
  order        Int        @default(0)
  // Which "level batch" this module belongs to: beginner / intermediate /
  // advanced. The initial generation copies the curriculum's level; subsequent
  // "Generate next level" runs add modules at the next tier so a single
  // curriculum can grow through the levels over time.
  level        String     @default("beginner")
  objectives   Json
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  lessons      Lesson[]

  @@index([curriculumId])
  @@map("module")
}

enum LessonActivityType {
  VIDEO
  QUIZ
  EXERCISE
  PROJECT
  DISCUSSION
  READING
  OTHER
}

// Tracks whether the lesson has had its full AI content + per-type child rows
// generated. STUB rows are created at curriculum-creation time so each lesson
// already has a stable id/url; READY means a full generation has succeeded.
enum LessonStatus {
  STUB
  GENERATING
  READY
  FAILED
}

model Lesson {
  id                   String             @id
  moduleId             String
  module               Module             @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title                String
  description          String             @default("")
  summary              String             @default("")
  activityType         LessonActivityType
  // 1-indexed position within the module
  order                Int                @default(0)
  status               LessonStatus       @default(STUB)
  content              String             @default("")
  duration             String             @default("")
  objectives           Json               @default("[]")
  recommendedResources Json               @default("[]")
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  quizzes              Quiz[]
  videos               Video[]
  exercises            Exercise[]
  projects             Project[]
  discussions          Discussion[]
  readings             Readings[]
  notes                Note[]
  annotations          Annotation[]
  // User-attached resources (uploaded files or saved links) the user has
  // pinned to this lesson. Distinct from `recommendedResources` above, which
  // is the AI's suggestion list.
  resourceLinks        ResourceLesson[]
  generatedAudios      GeneratedAudio[]
  // Sessions reference lessons indirectly through StudySession.lessonIds (Json),
  // not a relational FK, so we don't list them here.

  @@index([moduleId])
  @@map("lesson")
}

model Video {
  id           String   @id
  lessonId     String
  lesson       Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title        String
  description  String
  // AI overview shown above the embed, distinct from the AI's short description
  overview     String   @default("")
  embedUrl     String
  // External link surfaced when embedUrl can't be embedded (non-YouTube, etc.)
  externalUrl  String?
  thumbnailUrl String?
  duration     String   @default("")
  isCompleted  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([lessonId])
  @@map("video")
}

model Quiz {
  id                   String   @id
  lessonId             String
  lesson               Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title                String
  // Topic overview shown above the deep-dive (2-4 short paragraphs).
  overview             String   @default("")
  // Pre-assessment reading on the lesson topic (markdown).
  content              String   @default("")
  // Recommended readings (Google search) and videos (YouTube search) shown
  // alongside the reading so the learner can study before taking the quiz.
  recommendedResources Json     @default("[]")
  // Flips true after the learner clicks "Generate quiz" and the AI returns
  // the question set. Until then, `questions` is `[]` and the UI shows the
  // reading + a "Generate quiz" call-to-action.
  questionsGenerated   Boolean  @default(false)
  // Array of QuizQuestion: { question, answers: string[], correctAnswerIndex }
  questions            Json     @default("[]")
  // Array of indices the user submitted, parallel to questions
  userAnswers          Json?
  feedback             Json?
  score                Int      @default(0)
  maxScore             Int      @default(100)
  passScore            Int      @default(65)
  isPassed             Boolean  @default(false)
  isCompleted          Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([lessonId])
  @@map("quiz")
}

model Exercise {
  id                   String   @id
  lessonId             String
  lesson               Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title                String
  description          String
  // Topic overview shown above the deep-dive (2-4 short paragraphs).
  overview             String   @default("")
  // Pre-assessment reading on the lesson topic (markdown).
  content              String   @default("")
  // Recommended readings + videos to study before tackling the exercise.
  recommendedResources Json     @default("[]")
  // See Quiz.questionsGenerated.
  questionsGenerated   Boolean  @default(false)
  // Same shape as Quiz.questions — exercises are MC assessments per spec
  questions            Json     @default("[]")
  hints                Json     @default("[]")
  userAnswers          Json?
  score                Int      @default(0)
  maxScore             Int      @default(100)
  passScore            Int      @default(65)
  isPassed             Boolean  @default(false)
  isCompleted          Boolean  @default(false)
  feedback             Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([lessonId])
  @@map("exercise")
}

enum ProjectType {
  PRESENTATION
  REPORT
  ARTICLE
  ESSAY
  RESEARCH_PAPER
  THESIS
  CODE_SNIPPET
  CODE_PROJECT
  OTHER
}

model Project {
  id                   String      @id
  lessonId             String
  lesson               Lesson      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title                String
  summary              String
  // Rubric-style objectives the learner must meet
  objectives           Json
  recommendedResources Json
  projectType          ProjectType
  submissionUrl        String?
  isCompleted          Boolean     @default(false)
  feedback             Json?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  @@index([lessonId])
  @@map("project")
}

model Discussion {
  id                   String   @id
  lessonId             String
  lesson               Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title                String
  summary              String
  // Talking points / objectives the discussion should explore
  objectives           Json
  recommendedResources Json
  // Array of { role: 'assistant' | 'user', content: string, createdAt: ISO }
  chatHistory          Json     @default("[]")
  isCompleted          Boolean  @default(false)
  // True when the learner used the Skip action instead of completing the
  // discussion organically. Skipped discussions still count toward curriculum
  // progression (and level unlock) but render a distinct banner so the user
  // can tell at a glance which ones they engaged with vs. skipped past.
  wasSkipped           Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([lessonId])
  @@map("discussion")
}

model Readings {
  id                   String   @id
  lessonId             String
  lesson               Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title                String
  summary              String
  // Topic overview displayed above the deep-dive
  overview             String   @default("")
  // The main body / deep-dive content (markdown)
  content              String
  recommendedResources Json
  isCompleted          Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([lessonId])
  @@map("readings")
}

// Single polymorphic notes table. A note belongs to a user and can optionally
// be scoped to a lesson, a curriculum, and/or a resource:
//  - lessonId set, curriculumId set     → in-lesson note (also surfaces in the
//                                         curriculum's Notes tab via curriculumId)
//  - lessonId null, curriculumId set    → curriculum-level note
//  - resourceId set                     → note attached to a saved resource
//                                         (file upload or external link); the
//                                         /resources/[id] viewer surfaces it
//  - lessonId null, curriculumId null,
//    resourceId null                    → free-form user note (homepage / /notes)
//
// Notes can also carry a `tags` array of short labels the learner adds via
// the editor. They're independent of curriculum/lesson/resource scope and
// drive the Notes-page tag filter.
model Note {
  id           String       @id
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId     String?
  lesson       Lesson?      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  curriculumId String?
  curriculum   Curriculum?  @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  resourceId   String?
  resource     Resource?    @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  title        String?
  // Optional short user-supplied description shown under the title on the
  // dedicated note page. Capped at 500 chars; can be (re)generated by the
  // "Summarize my note" AI button.
  description  String?
  content      String
  // User-supplied tag labels. Capped per-tag at ~32 chars and ~12 tags per
  // note by the API; the column is unbounded so future bulk imports don't
  // need a migration. Defaulted to an empty array so older rows behave like
  // untagged notes.
  tags         String[]     @default([])
  // True when this note is the auto-managed annotations note for a lesson
  // or resource. We aggregate annotation quote+commentary into the content
  // of this note and reuse the same row for every annotation on
  // (user, lesson) or (user, resource).
  isAnnotation Boolean      @default(false)
  annotations  Annotation[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([userId])
  @@index([lessonId])
  @@index([curriculumId])
  @@index([resourceId])
  @@map("note")
}

// Long-form, source-spanning learner notebook. Unlike `Note`, a ContinuityNote
// is *not* pinned to a single lesson/curriculum/resource — instead, links to
// resources/lessons/courses are embedded directly in the rich-text body via
// the editor's "Insert link" picker. The content column holds editor-emitted
// HTML so we can round-trip styling (headings, colours, highlights, lists,
// quotes, code) without parsing markdown back and forth.
model ContinuityNote {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Optional title — UI shows "Untitled note" when blank so the user isn't
  // forced to name a note before they start writing.
  title     String?
  // Rich-text body as HTML emitted by the TipTap editor. Stored verbatim so
  // links/highlights/etc. survive a round trip; we never sanitise on read,
  // only on write.
  content   String   @default("")
  // Free-form tags (NOTE_MAX_TAGS · NOTE_TAG_MAX_LENGTH constants apply on
  // write). Mirrors the markdown `Note.tags` column so the regular-note
  // tag UX and the continuity-note tag UX share helpers.
  tags      String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("continuity_note")
}

// Five highlight colours the learner can pick from in the highlight toolbar.
// Stored as an enum so the renderer can map straight to Tailwind classes
// without trusting a free-form string from the client.
enum AnnotationColor {
  YELLOW
  PINK
  BLUE
  ORANGE
  GREEN
}

// User-saved highlight + optional commentary on a passage of a lesson OR a
// resource. Each annotation is rolled into the auto-managed "annotations"
// Note for that surface (see Note.isAnnotation). The dedicated row keeps
// the source of truth so we can render hover cards (when commentary is
// present) or plain colour-coded highlights (when it isn't) and rebuild
// the note on edit/delete.
//
// Exactly one of `lessonId` / `resourceId` is set per row — enforced at
// the application layer because Prisma can't express a polymorphic FK.
model Annotation {
  id         String          @id
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  // The lesson or resource the highlight is anchored to. Mutually exclusive;
  // see the row comment above.
  lessonId   String?
  lesson     Lesson?         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  resourceId String?
  resource   Resource?       @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  noteId     String
  note       Note            @relation(fields: [noteId], references: [id], onDelete: Cascade)
  // The exact text the user highlighted.
  quote      String
  // The user's commentary. Nullable now: an empty annotation just paints a
  // coloured highlight on the passage without surfacing a popover/hover card.
  annotation String?
  // Which highlight colour to render. Picked from the toolbar at highlight
  // time; older rows default to YELLOW so they keep their existing look.
  color      AnnotationColor @default(YELLOW)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([userId])
  @@index([lessonId])
  @@index([resourceId])
  @@index([noteId])
  @@map("annotation")
}

// What flavour of Resource a row represents. LINK rows store an external URL
// (article, wiki, Reddit thread, etc.) and optionally cache an extracted
// reader-mode copy. FILE rows reference an object uploaded to Cloudflare R2.
enum ResourceKind {
  LINK
  FILE
}

// Supported upload formats for Resource.kind == FILE. PDFs are rendered in
// a same-origin iframe; TXT/MD are fetched once on upload and cached as
// markdown in Resource.content so the viewer can render + annotate them
// without re-fetching from R2 on every page load.
enum ResourceFileType {
  TXT
  PDF
  MD
}

// Lifecycle for an uploaded resource. PENDING is set the instant we mint a
// signed PUT URL; READY flips after the client confirms the upload and we
// HEAD the object (or extract the cached text). FAILED is reserved for the
// confirm step rejecting (e.g. file size mismatch).
enum ResourceStatus {
  PENDING
  READY
  FAILED
}

// A learner-owned reference to a piece of source material — either an
// uploaded file (TXT/PDF/MD on R2) or a saved external URL. Resources are
// always owned by a single user but can be attached to many curricula and
// many lessons via the explicit join tables below; the user's personal
// /resources collection is just "every Resource where ownerId = me".
model Resource {
  id                String               @id
  userId            String
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind              ResourceKind
  title             String
  // Optional free-form description the user types when adding the resource.
  // Capped at ~500 chars by the API; the column is unbounded.
  description       String?
  // ---------------- LINK fields ----------------
  // The exact URL the user pasted. Required for kind == LINK.
  url               String?
  // Hostname extracted from `url` (e.g. "en.wikipedia.org"). Cached so
  // /resources cards can show the source without re-parsing on every render.
  domain            String?
  // Reader-mode extracted markdown (from @mozilla/readability). Filled in
  // lazily on first view; null until extraction succeeds. The viewer falls
  // back to the raw iframe when this is null.
  extractedAt       DateTime?
  // ---------------- FILE fields ----------------
  // R2 object key (e.g. "users/{userId}/resources/{resourceId}.pdf"). Required
  // for kind == FILE and never exposed to the client — we always serve files
  // through a signed GET URL minted by the tRPC layer.
  fileKey           String?
  fileType          ResourceFileType?
  fileSize          Int?
  fileMimeType      String?
  // Original filename the user uploaded (for display + download).
  fileName          String?
  // ---------------- Shared ----------------
  // Cached renderable text/markdown. For TXT/MD this is the file body; for
  // LINK with extractedAt set this is the reader-mode markdown; for PDF
  // this stays null and the viewer falls back to the iframe path.
  content           String?
  status            ResourceStatus       @default(PENDING)
  // FAILED status comes with a short reason for the UI.
  statusMessage     String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  curriculumLinks   ResourceCurriculum[]
  lessonLinks       ResourceLesson[]
  notes             Note[]
  annotations       Annotation[]
  generatedAudios   GeneratedAudio[]
  // Provenance rows on curricula that were generated from this resource as
  // an input. SetNull on the source side means deleting this resource leaves
  // the curriculum's sources list intact with a tombstone entry.
  curriculumSources CurriculumSource[]

  @@index([userId])
  @@index([userId, kind])
  @@index([status])
  @@map("resource")
}

// Many-to-many between Resource and Curriculum. A user can pin one of their
// resources to multiple curricula, and curricula can carry multiple
// learner-attached resources alongside the AI's `recommendedResources` JSON.
// `createdAt` is preserved so the curriculum's resource list can render in
// reverse-chronological order without a join back to Resource.
model ResourceCurriculum {
  id           String     @id
  resourceId   String
  resource     Resource   @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  curriculumId String
  curriculum   Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([resourceId, curriculumId])
  @@index([curriculumId])
  @@map("resource_curriculum")
}

// Many-to-many between Resource and Lesson. Pinning a resource on a lesson
// page also creates the matching ResourceCurriculum row (the lesson's
// curriculum) so the resource shows up under both surfaces.
model ResourceLesson {
  id         String   @id
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  lessonId   String
  lesson     Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([resourceId, lessonId])
  @@index([lessonId])
  @@map("resource_lesson")
}

model UserEvaluations {
  id         String   @id
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  evaluation Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@map("user_evaluations")
}

// MORNING   = 08:00–12:00
// AFTERNOON = 12:00–17:00
// EVENING   = 17:00–21:00
// NIGHT     = 21:00–24:00
enum StudyTimeSlot {
  MORNING
  AFTERNOON
  EVENING
  NIGHT
}

// One active schedule per (user, curriculum). Editing replaces.
model StudySchedule {
  id                   String          @id
  userId               String
  user                 User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  curriculumId         String          @unique
  curriculum           Curriculum      @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  // 0=Sunday … 6=Saturday. Indices into JS Date#getDay() so the UI doesn't
  // need to translate.
  daysOfWeek           Int[]
  minutesPerDay        Int
  targetCompletionDate DateTime
  preferredTimeSlots   StudyTimeSlot[]
  startDate            DateTime        @default(now())
  // Whether the user accepted a "your end date is too soon" warning when
  // creating this schedule. Surfaced on the schedule UI so the user remembers.
  warningsAccepted     Boolean         @default(false)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  sessions             StudySession[]

  @@index([userId])
  @@map("study_schedule")
}

// One slot occupation per (userId, date, timeSlot). The unique constraint is
// what enforces "no double-booking across curricula" at the DB level.
//
// `lessonIds` is an ordered array of Lesson ids packed into the slot.
// `lessonOrders` mirrors `lessonIds` for sortable display in the UI without an
// extra join.
model StudySession {
  id           String        @id
  scheduleId   String
  schedule     StudySchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Stored as a Postgres DATE column so the unique constraint on
  // (userId, date, timeSlot) operates on calendar days. The JS round-trip
  // gives us UTC midnight; the queries layer re-anchors to noon UTC via
  // `normalizeDateFromDb()` so calendar UI and comparisons display the
  // correct local day.
  date         DateTime      @db.Date
  timeSlot     StudyTimeSlot
  durationMin  Int
  // Json arrays of strings — one per lesson packed into this slot.
  lessonIds    Json
  lessonTitles Json
  isCompleted  Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([userId, date, timeSlot])
  @@index([scheduleId])
  @@index([userId, date])
  @@map("study_session")
}

// Why-are-you-leaving survey rows captured when a user disables or deletes
// their account. Intentionally NOT a relation to User: deletion cascades
// would wipe these out, and the whole point is to keep the qualitative
// signal even after the user is gone.
enum AccountAction {
  DISABLE
  DELETE
}

model AccountFeedback {
  id        String        @id
  userId    String
  email     String
  action    AccountAction
  reason    String
  createdAt DateTime      @default(now())

  @@index([action])
  @@map("account_feedback")
}

// Pre-launch / alpha-period waitlist signups captured from the marketing site
// (apps/web). Email is unique so re-submissions just bump `updatedAt`. We
// optionally record the page the signup came from (`source`) so we can tell
// homepage CTA conversions apart from the dedicated /waitlist page.
//
// `welcomeEmailSentAt` lets the server action skip re-sending the welcome on
// duplicate submits, and `invitedAt` is set by the weekly invite cron so
// subsequent runs ignore already-invited entries.
model WaitlistEntry {
  id                 String        @id
  firstName          String
  email              String
  source             String?
  welcomeEmailSentAt DateTime?
  invitedAt          DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  invites            AlphaInvite[]

  @@unique([email])
  @@index([invitedAt])
  @@map("waitlist_entry")
}

// Per-email alpha access keys minted by the weekly invite cron. Replaces the
// old single `ALPHA_CODE` env-var model: each row binds a single-use,
// expiring `accessKey` to one waitlist email so the marketing site can roll
// out invites in waves and keys can rotate (revoke + re-issue) per user.
//
// `email` is *not* a foreign key to User — invites are minted before the
// user account exists. `redeemedByUserId` is filled in once the user
// successfully registers with this key.
model AlphaInvite {
  id               String         @id
  // Lower-case email for case-insensitive lookups; matches WaitlistEntry.email.
  email            String
  // Opaque, URL-safe, unique. The user pastes / clicks-through this to
  // unlock the registration form.
  accessKey        String         @unique
  // FK back to the waitlist row. Nullable so an admin can hand-mint keys
  // for emails that never went through the marketing site.
  waitlistEntryId  String?
  waitlistEntry    WaitlistEntry? @relation(fields: [waitlistEntryId], references: [id], onDelete: SetNull)
  // When the invite email was actually delivered to Resend.
  sentAt           DateTime?
  // After this point the key stops working and the user must request a new
  // one. Defaults set by the cron (typically 14 days out).
  expiresAt        DateTime
  // Set when the user successfully signs up using this key.
  redeemedAt       DateTime?
  redeemedByUserId String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([email])
  @@index([expiresAt])
  @@map("alpha_invite")
}

// Daily check-ins. Streak is derived from these rows (no denormalised counter
// to keep in sync). Date is a day-precision value to make the unique
// constraint enforce one check-in per calendar day.
model CheckIn {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // See StudySession.date — DATE column for calendar-day uniqueness.
  date      DateTime @db.Date
  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@index([userId])
  @@map("check_in")
}

// What kind of AI call produced a usage row. Keeps `kind` typed so the admin
// dashboard can break tokens down by feature without a free-form string.
enum AiUsageKind {
  CURRICULUM
  CURRICULUM_BACKFILL
  // Multi-source (Continuity) curriculum generation. Tracked separately
  // from the single-source CURRICULUM kind so the admin dashboard can
  // see how much more these calls cost on average.
  CURRICULUM_CONTINUITY
  // Thesis statement generation from selected continuity notes — a short
  // call but priced distinctly so the curricula totals stay clean.
  CURRICULUM_THESIS
  LESSON
  DISCUSSION_REPLY
  SUBMISSION_FEEDBACK
  NOTE_SUMMARY
  TTS
}

// Token-usage telemetry for every server-side AI call we make on behalf of
// a user. Written immediately after the model call succeeds so the admin
// console can aggregate per-user / per-feature spend without re-counting
// from logs. `userId` is intentionally NOT a FK — we want the row to
// survive user deletion for ops accounting.
model AiUsage {
  id           String      @id
  userId       String?
  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  kind         AiUsageKind
  // Model identifier as passed to the AI SDK, e.g. "gemini-2.5-flash-lite".
  model        String
  inputTokens  Int         @default(0)
  outputTokens Int         @default(0)
  totalTokens  Int         @default(0)
  // Free-form id of the entity this call relates to (curriculumId, lessonId,
  // noteId, etc.) for forensic drill-down. Optional because not every call
  // has one obvious owner.
  resourceId   String?
  createdAt    DateTime    @default(now())

  @@index([userId])
  @@index([kind])
  @@index([createdAt])
  @@map("ai_usage")
}

// What surface a generated audio was created for. Drives both the title
// display ("Lesson Title - Overview") and the icon shown in the audio
// library list. Adding a new value here is a breaking enum change and
// requires a migration.
enum AudioSourceKind {
  LESSON_OVERVIEW
  LESSON_READING
  LESSON_VIDEO_OVERVIEW
  LESSON_QUIZ_OVERVIEW
  LESSON_QUIZ_READING
  RESOURCE_READER
  CURRICULUM_OVERVIEW
  COURSE_OBJECTIVES
  GENERIC
}

// One synthesised TTS audio clip, persisted to R2 so the user never has
// to wait for re-generation. We dedupe on `(userId, contextKey)` where
// `contextKey` is a SHA-256 of the cleaned passage + voice + model — a
// click on the same Speak Text button always returns the existing row.
model GeneratedAudio {
  id              String              @id
  userId          String
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Stable hash of (cleaned text, voice, model). Re-generating with the
  // same parameters maps to the same clip.
  contextKey      String
  voice           String              @default("Kore")
  model           String
  // Source metadata. The FKs are SetNull so a deleted lesson/resource
  // doesn't drop the user's audio library; the cached `title` / `section`
  // fields still let the bar render something useful.
  sourceKind      AudioSourceKind
  lessonId        String?
  lesson          Lesson?             @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  curriculumId    String?
  curriculum      Curriculum?         @relation(fields: [curriculumId], references: [id], onDelete: SetNull)
  resourceId      String?
  resource        Resource?           @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  // Frozen display strings so a renamed lesson doesn't retroactively
  // re-title an existing audio (and vice versa for deletes).
  title           String
  section         String?
  // R2 storage. `audioKey` is `users/{userId}/audio/{audioId}.wav`.
  audioKey        String
  audioMimeType   String              @default("audio/wav")
  audioBytes      Int
  // Duration is best-effort: derived from the PCM byte length we get
  // back from Gemini, so it's accurate to within a sample. NULL if the
  // calculation fails for any reason.
  durationSeconds Float?
  // Bookkeeping for the library UI.
  characterCount  Int
  truncated       Boolean             @default(false)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  playlistItems   AudioPlaylistItem[]

  @@unique([userId, contextKey])
  @@index([userId])
  @@index([userId, createdAt])
  @@index([userId, lessonId])
  @@index([userId, curriculumId])
  @@index([userId, resourceId])
  @@map("generated_audio")
}

// Single user-scoped playback queue. Items are a many-to-one onto
// GeneratedAudio (the audio itself owns the bytes); this table only
// captures position. Position is dense (0,1,2…) and rewritten on each
// reorder; the unique index on (userId, audioId) keeps a clip from
// appearing twice in the same queue.
model AudioPlaylistItem {
  id       String         @id
  userId   String
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  audioId  String
  audio    GeneratedAudio @relation(fields: [audioId], references: [id], onDelete: Cascade)
  // 0-indexed order. Rewritten in bulk on reorder/remove so gaps never
  // accumulate.
  position Int
  addedAt  DateTime       @default(now())

  @@unique([userId, audioId])
  @@index([userId, position])
  @@map("audio_playlist_item")
}
