{
    "name": "quazom-ai",
    "version": "0.1.0",
    "private": true,
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "dev:main": "npm --workspace apps/main run dev",
        "build:main": "npm --workspace apps/main run build",
        "dev:web": "npm --workspace apps/web run dev",
        "build:web": "npm --workspace apps/web run build",
    "dev:docs": "npm --workspace apps/docs run dev",
    "build:docs": "npm --workspace apps/docs run build",
    "dev:emails": "npm --workspace @quazom-ai/emails run dev",
    "lint": "npm --workspaces run lint",
    "dev:all": "mprocs"
    },
    "devDependencies": {
        "mprocs": "^0.9.2"
    },
    "optionalDependencies": {
        "@tailwindcss/oxide-linux-x64-gnu": "4.2.4",
        "lightningcss-linux-x64-gnu": "1.32.0"
    }
}
